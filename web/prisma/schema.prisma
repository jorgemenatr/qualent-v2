generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// User & Authentication
// ============================================================================

model User {
  id            String    @id @default(cuid())
  cognitoId     String    @unique @map("cognito_id")
  email         String    @unique
  name          String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  toolSaves            ToolSave[]
  chatSessions         ChatSession[]
  downloads            Download[]
  companyProfile       CompanyProfile?
  worksheetSubmissions WorksheetSubmission[]

  // Project relations
  ownedProjects        Project[]         @relation("ProjectOwner")
  projectMemberships   ProjectMember[]
  assignedTasks        Task[]            @relation("TaskAssignee")
  uploadedDocuments    ProjectDocument[] @relation("DocumentUploader")

  // Audio relations
  uploadedAudios       AudioFile[]       @relation("AudioUploader")

  @@map("users")
}

// ============================================================================
// Contacts (for PDF gating)
// ============================================================================

model Contact {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  company       String?
  source        String?   // e.g., "pdf_download", "newsletter"
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  downloads     Download[]

  @@map("contacts")
}

// ============================================================================
// Downloads (tracking PDF downloads)
// ============================================================================

model Download {
  id            String    @id @default(cuid())
  reportSlug    String    @map("report_slug")
  downloadedAt  DateTime  @default(now()) @map("downloaded_at")

  // Relations
  contactId     String?   @map("contact_id")
  contact       Contact?  @relation(fields: [contactId], references: [id])
  userId        String?   @map("user_id")
  user          User?     @relation(fields: [userId], references: [id])

  @@map("downloads")
}

// ============================================================================
// Tool Saves (for FIVES, Build vs Buy, etc.)
// ============================================================================

model ToolSave {
  id            String    @id @default(cuid())
  toolType      String    @map("tool_type") // "fives", "build_vs_buy", "prioritization"
  name          String    // User-given name for this save
  data          Json      // The actual tool state/data
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  userId        String    @map("user_id")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, toolType])
  @@map("tool_saves")
}

// ============================================================================
// Company Profile
// ============================================================================

model CompanyProfile {
  id            String    @id @default(cuid())
  companyName   String    @map("company_name")
  industry      String?
  companySize   String?   @map("company_size") // "1-10", "11-50", "51-200", "201-500", "500+"
  userRole      String?   @map("user_role")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations (one-to-one with User)
  userId        String    @unique @map("user_id")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("company_profiles")
}

// ============================================================================
// Worksheet Submissions
// ============================================================================

model WorksheetSubmission {
  id            String    @id @default(cuid())
  name          String    @default("My Worksheet")
  data          Json      // Full worksheet FormData
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  userId        String    @map("user_id")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("worksheet_submissions")
}

// ============================================================================
// Chat Sessions
// ============================================================================

model ChatSession {
  id            String    @id @default(cuid())
  title         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  userId        String?   @map("user_id")
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages      ChatMessage[]

  @@map("chat_sessions")
}

model ChatMessage {
  id            String    @id @default(cuid())
  role          String    // "user" or "assistant"
  content       String
  citations     Json?     // Array of citation objects
  createdAt     DateTime  @default(now()) @map("created_at")

  // Relations
  sessionId     String    @map("session_id")
  session       ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}

// ============================================================================
// Thunk Box Requests
// ============================================================================

model ThunkBoxRequest {
  id            String    @id @default(cuid())
  email         String
  name          String?
  company       String?
  request       String    @db.Text
  status        String    @default("pending") // "pending", "in_progress", "completed"
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("thunk_box_requests")
}

// ============================================================================
// Client Project Portal
// ============================================================================

model Project {
  id              String    @id @default(cuid())
  name            String
  description     String?   @db.Text
  status          String    @default("active") // "active", "on_hold", "completed", "cancelled"

  // Budget
  totalBudget     Decimal?  @map("total_budget") @db.Decimal(12, 2)
  amountSpent     Decimal   @default(0) @map("amount_spent") @db.Decimal(12, 2)
  currency        String    @default("CAD")

  // Dates
  startDate       DateTime? @map("start_date")
  targetEndDate   DateTime? @map("target_end_date")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relations
  ownerId         String    @map("owner_id")
  owner           User      @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members         ProjectMember[]
  milestones      Milestone[]
  tasks           Task[]
  documents       ProjectDocument[]

  @@index([ownerId])
  @@index([status])
  @@map("projects")
}

model ProjectMember {
  id            String    @id @default(cuid())
  role          String    @default("member") // "owner", "admin", "member", "viewer"
  createdAt     DateTime  @default(now()) @map("created_at")

  // Relations
  projectId     String    @map("project_id")
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId        String    @map("user_id")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model Milestone {
  id            String    @id @default(cuid())
  name          String
  description   String?   @db.Text
  status        String    @default("pending") // "pending", "in_progress", "completed"
  dueDate       DateTime? @map("due_date")
  completedAt   DateTime? @map("completed_at")
  sortOrder     Int       @default(0) @map("sort_order")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  projectId     String    @map("project_id")
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks         Task[]

  @@index([projectId])
  @@map("milestones")
}

model Task {
  id            String    @id @default(cuid())
  title         String
  description   String?   @db.Text
  status        String    @default("todo") // "todo", "in_progress", "review", "completed"
  priority      String    @default("medium") // "low", "medium", "high", "urgent"
  dueDate       DateTime? @map("due_date")
  completedAt   DateTime? @map("completed_at")
  sortOrder     Int       @default(0) @map("sort_order")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  projectId     String    @map("project_id")
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestoneId   String?   @map("milestone_id")
  milestone     Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  assigneeId    String?   @map("assignee_id")
  assignee      User?     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([milestoneId])
  @@index([assigneeId])
  @@map("tasks")
}

model ProjectDocument {
  id            String    @id @default(cuid())
  name          String
  description   String?
  type          String    @default("general") // "business", "technical", "general"

  // Either s3Key (file upload) or externalUrl (link)
  s3Key         String?   @map("s3_key")
  externalUrl   String?   @map("external_url")
  fileName      String?   @map("file_name")
  fileSize      Int?      @map("file_size") // bytes
  mimeType      String?   @map("mime_type")

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  projectId     String    @map("project_id")
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedById  String    @map("uploaded_by_id")
  uploadedBy    User      @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([type])
  @@map("project_documents")
}

// ============================================================================
// Audio Files (for report audio versions)
// ============================================================================

model AudioFile {
  id            String    @id @default(cuid())
  slug          String    @unique  // matches report slug, e.g., "ai-automation-roi-guide"
  name          String               // display name, e.g., "AI Automation ROI Guide"
  description   String?

  s3Key         String    @map("s3_key")      // e.g., "audio/ai-automation-roi-guide.mp3"
  fileName      String    @map("file_name")   // original uploaded filename
  fileSize      Int       @map("file_size")   // bytes
  mimeType      String    @map("mime_type")   // e.g., "audio/mpeg"
  duration      String                        // e.g., "12:34"
  available     Boolean   @default(true)

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  uploadedById  String    @map("uploaded_by_id")
  uploadedBy    User      @relation("AudioUploader", fields: [uploadedById], references: [id])

  @@map("audio_files")
}
