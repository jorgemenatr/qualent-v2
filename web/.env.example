# =============================================================================
# PickleLlama Website Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values
# Get values from: terraform output env_file_content
# =============================================================================

# -----------------------------------------------------------------------------
# Database (from Terraform output)
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# Optional: ARN of Secrets Manager secret (for rotating credentials)
DATABASE_SECRET_ARN=""

# -----------------------------------------------------------------------------
# AWS Cognito (from Terraform output)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_COGNITO_USER_POOL_ID=""
NEXT_PUBLIC_COGNITO_CLIENT_ID=""
NEXT_PUBLIC_COGNITO_DOMAIN=""
COGNITO_ISSUER=""

# -----------------------------------------------------------------------------
# AWS S3 (from Terraform output)
# Note: Can't use AWS_ prefix - reserved by Amplify
# -----------------------------------------------------------------------------
S3_BUCKET_NAME="picklellama-content"
S3_REGION="ca-central-1"

# S3 credentials (for local dev only - in production, Amplify uses IAM roles)
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# -----------------------------------------------------------------------------
# AWS SES (from Terraform output)
# -----------------------------------------------------------------------------
AWS_SES_REGION="ca-central-1"
SES_FROM_EMAIL="hello@picklellama.studio"

# -----------------------------------------------------------------------------
# AI Services
# -----------------------------------------------------------------------------
# Google AI (for Gemini RAG retrieval)
GOOGLE_AI_API_KEY=""
GEMINI_CORPUS_NAME="pickle-knowledge-base"

# Anthropic (for Claude chat responses)
ANTHROPIC_API_KEY=""

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: Analytics & Monitoring
SENTRY_DSN=""
